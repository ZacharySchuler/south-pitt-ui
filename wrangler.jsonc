{
	"main": "dist/_worker.js/index.js",
	"name": "south-pitt-ui",
	"compatibility_date": "2025-12-13",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "south-pitt-history-metadata",
			"database_id": "3a327522-3b0b-4d55-abd1-50225345009d",
			"migrations_dir": "migrations"
		}
	]
}
