# Copy to `.env` for local builds. Set the same names as Cloudflare build/runtime vars in production.
# Scripts stay off until both (or either) ID is present — the site still builds without them.

# Google Analytics 4 measurement ID (Admin → Data streams → Web → Measurement ID)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID (Events Manager → Data sources → Pixel)
PUBLIC_META_PIXEL_ID=123456789012345
