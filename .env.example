# Optional overrides for local builds. GA4 has a public default in Analytics.astro.
# Set Meta Pixel in Cloudflare build/env vars (or here) when you have an ID.

# Optional override for Google Analytics 4 (default in code: G-4FT2F15889)
# PUBLIC_GA_MEASUREMENT_ID=G-4FT2F15889

# Meta (Facebook) Pixel ID (Events Manager → Data sources → Pixel)
PUBLIC_META_PIXEL_ID=123456789012345
