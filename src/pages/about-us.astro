---
import Layout from "../layouts/Layout.astro";
import aboutData from "../data/about-us.json";

const { board, coaches } = aboutData;
---

<Layout>
  <section class="about-sprfc" aria-labelledby="about-title">
    <header class="about-header">
      <h1 id="about-title">About South Pittsburgh Rugby Football Club</h1>
      <p class="about-intro">
        Founded in 1979, the South Pittsburgh Rugby Football Club is a 501(c)(3)
        organization that aims to grow the game of Rugby Union in Southwestern
        Pennsylvania through the development of rugby players of all skill
        level. The organization also aims to grow the game of Rugby Union by
        supporting events and matches at all levels. Built on community, refined
        through competition, and united by a shared commitment to the traditions
        of the game, the South Pitt Rugby Club is an essential
        part of the thriving Pittsburgh Rugby community.
      </p>
    </header>

    <div class="about-columns">
      <!-- Organization -->
      <article class="about-column">
        <h1>The Organization</h1>

        <p>
          South Pittsburgh Rugby Football Club fosters Rugby Union competition
          and the growing of the sport through various events. See <a
            href="/culture">our culture page</a
          > for the type of events that the organization supports.
        </p>

        <h2>Executive Board</h2>

        <div class="executive-board">
          {Object.entries(board).map(([position, member]) => (
            <section class="executive-role">
              <h3>{position} - {member.name}</h3>
              <ul>
                <li>
                  <a href={`mailto:${member.email}`}>{member.email}</a>
                </li>
                <li>
                  <a href={`tel:${member.phone}`}>{member.phone}</a>
                </li>
              </ul>
            </section>
          ))}
        </div>
      </article>

      <article class="about-column">
        <h1>The Team</h1>

        <p>
          The South Pittsburgh Rugby Club also fields Mens Teams for the <a
            href="https://midwest.rugby/"
            >Midwest Rugby Union.
          </a> South Pitt currently fields 2 teams, at the D2 and D4 level.
        </p>

        <p>
          The team actively trains and plays during the below seasons. Outside
          of the defined seasons, most players stay fit through informal
          individual-lead team workouts and <a href="/culture"
            >organization sponsored events</a
          >
        </p>

        <h2>The Fall Season</h2>
        <p>
          The fall season season falls roughly between August and November and
          represents the bulk of normal-season league play. For South Pitt, the
          fall season is categorized by multiple practices a week with games
          typically occuring every Saturday.
        </p>

        <h2>The Spring Season</h2>
        <p>
          The spring season typically runs between March and June and is normally considered the "pre-season." The spring season
          typically consists of friendly matches and off-season training, with official team practices occuring.
        </p>
          <p>For years like 2024, where the team wins their league, the Spring Season is spent preparing for Championship-level games as they occur during the spring months. </p>
        
      </article>

      <article class="about-column">
        <h1>Coaching Staff</h1>
        <p>
          Our coaches keep the squad sharp, accountable, and progressing through each season.
        </p>
        <ul>
          {Object.entries(coaches).map(([position, coach]) => (
            <li>
              {position} - {coach.name} (
              <a href={`mailto:${coach.email}`}>{coach.email}</a>,{" "}
              <a href={`tel:${coach.phone}`}>{coach.phone}</a>
              )
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>
</Layout>

<style>
  .about-sprfc {
    --accent: #d4af37;
    --accent-deep: #1f3c88;
    --ink: #f7f3ea;
    --panel: rgba(12, 22, 50, 0.78);
    --panel-border: rgba(212, 175, 55, 0.4);
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1rem;
    position: relative;
    color: var(--ink);
  }

  .about-header {
    margin-bottom: 2rem;
    position: relative;
    padding: 1.5rem 1.25rem;
    border-radius: 18px;
    background: linear-gradient(
        135deg,
        rgba(212, 175, 55, 0.515),
        rgba(31, 61, 136, 0.714)
      ),
      radial-gradient(circle at top left, rgba(212, 175, 55, 0.28), transparent 1000%);
    border: 1px solid rgba(212, 175, 55, 0.45);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
  }

  .about-header h1 {
    font-size: clamp(2rem, 3vw, 2.6rem);
    margin-bottom: 0.5rem;
    letter-spacing: 0.01em;
    text-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
  }

  .about-header::after {
    content: "";
    display: block;
    width: clamp(120px, 25%, 180px);
    height: 3px;
    margin-top: 1rem;
    background: linear-gradient(90deg, var(--accent), rgba(31, 60, 136, 0.1));
  }

  .about-intro {
    max-width: 720px;
    line-height: 1.6;
    opacity: 1;
    color: #fdf7ea;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .about-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .about-column {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 20px;
    padding: 1.75rem;
    box-shadow: 0 24px 45px rgba(0, 0, 0, 0.25);
    position: relative;
    overflow: hidden;
    animation: riseIn 600ms ease forwards;
  }

  .about-column h1,
  .about-column h2 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.45rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .about-column h1 {
    font-size: 1.1rem;
    color: var(--accent);
  }

  .about-column p {
    margin: 0 0 0.85rem;
    line-height: 1.65;
  }

  .executive-board {
    display: grid;
    gap: 1.25rem;
  }

  .executive-role {
    padding-left: 0.85rem;
    border-left: 2px solid rgba(212, 175, 55, 0.5);
  }

  .executive-role h3 {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
  }

  .executive-role p {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .executive-role ul {
    margin: 0;
    padding-left: 1.2rem;
    line-height: 1.6;
  }

  .executive-role li {
    margin-bottom: 0.35rem;
  }

  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-column {
      animation: none;
    }
  }

  @media (min-width: 900px) {
    .about-columns {
      grid-template-columns: 1fr 1fr;
    }

    .about-column:nth-child(2) {
      animation-delay: 120ms;
    }
  }
</style>
