---
import Layout from "../layouts/Layout.astro";
import springSeason2026 from "../assets/schedules/spring-season-2026.jpg";
---
<Layout>
  <section class="schedule-shell">
    <div class="schedule-card">
      <div class="schedule-copy">
        <h1>Match Schedule</h1>
        <h2>Spring 2026</h2>
      </div>
      <figure class="schedule-poster">
        <button class="poster-trigger" type="button" aria-label="View schedule full screen">
          <img
            src={springSeason2026.src}
            alt="South Pitt Rugby Spring 2026 match schedule poster"
          />
        </button>
      </figure>
      <div class="poster-modal" role="dialog" aria-modal="true" aria-hidden="true">
        <button class="poster-close" type="button" aria-label="Close full screen view">
          ✕
        </button>
        <img
          src={springSeason2026.src}
          alt="South Pitt Rugby Spring 2026 match schedule poster"
        />
      </div>
    </div>
  </section>
</Layout>

<script>
  const modal = document.querySelector(".poster-modal");
  const trigger = document.querySelector(".poster-trigger");
  const closeButton = document.querySelector(".poster-close");

  const setModalState = (isOpen) => {
    modal?.classList.toggle("is-open", isOpen);
    modal?.setAttribute("aria-hidden", String(!isOpen));
    document.body.style.overflow = isOpen ? "hidden" : "";
  };

  trigger?.addEventListener("click", () => {
    setModalState(true);
  });

  closeButton?.addEventListener("click", () => {
    setModalState(false);
  });

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) {
      setModalState(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setModalState(false);
    }
  });
</script>

<style>
  .schedule-shell {
    min-height: calc(100dvh - 160px);
    display: grid;
    place-items: center;
    padding: 3rem 1.5rem 4rem;
  }

  .schedule-card {
    width: min(1100px, 100%);
    display: grid;
    gap: 2.5rem;
    padding: 2.5rem;
    border-radius: 24px;
    background: linear-gradient(135deg, #ffffff 0%, #f3e7d6 100%);
    box-shadow: 0 20px 50px rgba(31, 60, 136, 0.15);
  }

  .schedule-copy {
    display: grid;
    gap: 1.25rem;
  }


  .schedule-copy h1 {
    font-family: "Georgia", "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    color: #1a1a1a;
  }


  .schedule-poster {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #1f3c88;
    display: grid;
    place-items: center;
    padding: 0.75rem;
  }

  .poster-trigger {
    border: none;
    background: none;
    padding: 0;
    cursor: zoom-in;
    width: 100%;
  }

  .schedule-poster img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 14px;
    background: #0f1f46;
  }

  .poster-modal {
    position: fixed;
    inset: 0;
    background: rgba(12, 18, 30, 0.88);
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    z-index: 200;
    padding: 2rem 1.5rem;
  }

  .poster-modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .poster-modal img {
    width: min(90vw, 1000px);
    max-height: 85vh;
    object-fit: contain;
    border-radius: 18px;
    background: #0f1f46;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
  }

  .poster-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    border: none;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 1.75rem;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    cursor: pointer;
  }

  @media (min-width: 900px) {
    .schedule-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      padding: 3rem;
    }

    .schedule-poster img {
      max-height: 520px;
    }
  }
</style>
