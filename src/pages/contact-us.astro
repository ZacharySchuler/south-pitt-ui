---
import Layout from "../layouts/Layout.astro";
import discordIcon from "../assets/social-media-icons/discord.svg";
import ContactComponent from "../components/ContactComponent.astro";


---
<Layout>
  <section class="contact-page" aria-labelledby="contact-title">
    <header class="contact-hero">
      <div class="hero-copy">
        <h1 id="contact-title">Contact Us</h1>
        <p class="hero-lede">
          For match scheduling, sponsorship inquiries, or youth rugby support,
          please reach out on social media or
          email <a href="mailto:hooligansrugby@gmail.com">hooligansrugby@gmail.com</a>.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="mailto:hooligansrugby@gmail.com">Email the club</a>
        </div>
      </div>
      <ContactComponent/>
    </header>

    <div class="contact-grid">
      <article class="contact-card">
        <h2>Join the team</h2>
        <p>
          Interested in joining? Visit our <a href ="/join/"> Becoming a Hooligan</a> page for next steps or hop into our
          Discord to introduce yourself.
        </p>
        <div class="contact-role">
          <h3>Get started</h3>
          <ul>
            <li>
              <a href="/join">Become a Hooligan</a>
            </li>
            <li>
              <a
                href="https://discord.com/invite/HyA5YTWXp"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Join our Discord"
                class="discord-link"
              >
                <span>Join our Discord</span>
                <img src={discordIcon.src} alt="" />
              </a>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </section>
</Layout>

<style>
  .contact-page {
    --navy: #0b1224;
    --gold: #d4af37;
    --off-white: #f7f1e5;
    --ink: #11141a;
    --panel: rgba(255, 255, 255, 0.88);
    --panel-deep: rgba(13, 23, 46, 0.88);
    --shadow: rgba(8, 15, 30, 0.28);
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1rem 3.5rem;
    position: relative;
    color: var(--ink);
  }

  .contact-page::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 10% 10%, rgba(212, 175, 55, 0.2), transparent 55%),
      radial-gradient(circle at 80% 20%, rgba(34, 58, 120, 0.25), transparent 60%),
      linear-gradient(160deg, #fef5df 0%, #f7f7fb 60%, #f4efe7 100%);
    border-radius: 32px;
    z-index: -2;
  }

  .contact-page::after {
    content: "";
    position: absolute;
    inset: 16px;
    border-radius: 26px;
    border: 1px solid rgba(17, 20, 26, 0.08);
    z-index: -1;
    pointer-events: none;
  }

  .contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 2rem;
    align-items: stretch;
    margin-bottom: 2.5rem;
    animation: float-in 0.7s ease forwards;
  }

  .hero-copy {
    padding: 2rem;
    border-radius: 24px;
    background: linear-gradient(150deg, rgba(12, 18, 36, 0.95), rgba(20, 34, 64, 0.95));
    color: var(--off-white);
    box-shadow: 0 20px 45px var(--shadow);
  }


  .contact-hero h1 {
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-family: "Bebas Neue", "Impact", "Haettenschweiler", "Arial Narrow", sans-serif;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }

  .hero-lede {
    max-width: 620px;
    line-height: 1.7;
    font-size: 1.05rem;
    color: rgba(247, 241, 229, 0.9);
  }

  .hero-lede a {
    color: var(--gold);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .button.primary {
    background: var(--gold);
    color: #1a1407;
    box-shadow: 0 16px 30px rgba(212, 175, 55, 0.35);
  }

  .button.ghost {
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #fff5dc;
  }

  .button:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 35px rgba(0, 0, 0, 0.3);
  }



  

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.75rem;
  }

  .contact-card {
    border-radius: 22px;
    border: 1px solid rgba(15, 23, 42, 0.12);
    padding: 1.75rem;
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.95), rgba(245, 241, 233, 0.95));
    box-shadow: 0 20px 35px rgba(15, 23, 42, 0.12);
    position: relative;
    overflow: hidden;
    animation: float-in 0.6s ease forwards;
  }

  .contact-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
    font-family: "Bebas Neue", "Impact", "Haettenschweiler", "Arial Narrow", sans-serif;
    letter-spacing: 0.03em;
  }

  .contact-card p {
    margin: 0 0 1rem;
    line-height: 1.6;
  }

  .contact-role {
    background: rgba(15, 23, 42, 0.06);
    border-radius: 16px;
    padding: 1rem;
  }

  .contact-role h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: "Space Grotesk", "Trebuchet MS", sans-serif;
  }

  .contact-role ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .contact-role a,
  .contact-card a {
    color: inherit;
    text-decoration: underline;
  }

  .discord-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 600;
  }

  .discord-link img {
    height: 24px;
    width: 24px;
    display: block;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 6px;
    padding: 4px;
  }

  .contact-card:nth-child(1) {
    animation-delay: 0.1s;
  }

  .contact-card:nth-child(2) {
    animation-delay: 0.2s;
  }

  .contact-card:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .contact-hero {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-hero,
    .contact-card,
    .button {
      animation: none;
      transition: none;
    }
  }
</style>
