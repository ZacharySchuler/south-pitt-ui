---
import anytimeFitnessLogo from "../assets/sponsors/Anytime-Fitness-logo.png"
import davidBallarottoLogo from "../assets/sponsors/david-ballarotto.svg"
import eightPointFinancialLogo from "../assets/sponsors/eightpoint-financial.svg"
import whiteClawLogo from "../assets/sponsors/white-claw-hard-seltzer-logo-vector.svg"
import lapianaChiropracticLogo from "../assets/sponsors/lapiana-chiropractic-logo.svg"
import montuckyLogo from "../assets/sponsors/Montucky.svg"
import redsGoodNewsLogo from "../assets/sponsors/reds-good-news.jpg";
import pennBreweryIcon from "../assets/sponsors/penn-brewery-icon.png";

const images = [
  anytimeFitnessLogo,
  davidBallarottoLogo,
  eightPointFinancialLogo,
  whiteClawLogo,
  lapianaChiropracticLogo,
  montuckyLogo,
  redsGoodNewsLogo,
  pennBreweryIcon
];
---
<div class="sponsor-strip">
  {images.map(img => (
    <img src={img.src} alt="Sponsor logo" loading="lazy" />
  ))}
</div>

<style>
.sponsor-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 100%;          /* fill the footer height dynamically */
  width: 100%;
  max-width: 1200px;     /* optional max width for large screens */
  gap: 2rem;
}

.sponsor-strip img {
  max-width: 100px;      /* prevent images from being too wide */
  /* background: white; */
  /* margin: 1px; */
}

/* Responsive adjustments */
@media (max-width: 900px) {
  .sponsor-strip {
    gap: 1rem;
  }
  .sponsor-strip img {
    max-width: 100px;
  }
}

@media (max-width: 480px) {
  .sponsor-strip {
    flex-wrap: wrap;      /* wrap logos on very small screens */
    justify-content: center;
    gap: 0.75rem;
  }
  .sponsor-strip img {
    max-width: 80px;
  }
}
</style>