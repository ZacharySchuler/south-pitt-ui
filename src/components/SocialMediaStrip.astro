---
import facebookIcon from '../assets/social-media-icons/facebook_icon.svg';
import instagramIcon from '../assets/social-media-icons/Instagram_icon.svg';
import xIcon from '../assets/social-media-icons/x-icon.webp';
---

<div class="social-media-strip">
  <div id="social-icon">
    <a
      class="social-link"
      href="https://www.facebook.com/SouthPittRugby/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Facebook"
    >
      <img src={facebookIcon.src}/>
    </a>
  </div>
  <div id="social-icon">
    <a
      class="social-link"
      href="https://www.instagram.com/hooligansrfc/?hl=en"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
    >
      <img src={instagramIcon.src}/> 
    </a>
  </div>
  <div id="social-icon">
    <a
      class="social-link"
      href="https://twitter.com/HooligansRugby"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="X"
    >
      <img src = {xIcon.src}/>
    </a>
  </div>
</div>

<style>
  .social-media-strip {
    display: flex;
    flex-wrap: nowrap;
    flex-direction: row;

    align-items: center;

    gap: 1rem;
    padding: 1rem 2rem;
    max-height: 15vh;
    max-width: 20vh;
    
  }
  #social-icon img{
  width: 100%;
  height: 50px; 
  object-fit: cover; 
  }

</style>
