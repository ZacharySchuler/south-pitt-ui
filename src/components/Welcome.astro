---
import { Image } from "astro:assets";

import champs from "../assets/champs.jpeg";
import team1 from "../assets/team-pic-1.jpg";
import winterDinnerChamps from "../assets/winter-dinner-champs.jpg";
import SocialMediaStrip from "./SocialMediaStrip.astro";

---

<section class="hero">
  <div class="images images-desktop">
    <Image
      src={team1}
      alt="Rugby team group photo"
      class="side-image"
      loading="eager"
      fetchpriority="high"
    />

    <Image
      src={champs}
      alt="Rugby team celebrating championship victory"
      class="center-image"
      loading="eager"
      fetchpriority="high"
      sizes="(max-width: 900px) 100vw, 40vw"
    />

    <Image
      src={winterDinnerChamps}
      alt="Rugby team supporters and players"
      class="side-image"
      loading="eager"
      fetchpriority="high"
      sizes="(max-width: 900px) 100vw, 30vw"
    />
  </div>

  <div class="images images-mobile">
    <Image
      src={champs}
      alt="Rugby team celebrating championship victory"
      class="mobile-image"
      loading="eager"
      fetchpriority="high"
      sizes="100vw"
    />
  </div>

  <div class="overlay">
    <div class="content">
      <h1>Brotherhood. Community. Rugby.</h1>
      <!-- <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
        veniam, quis nostrud exercitation ullamco laboris.
      </p> -->

      <div class="cta">
        <a href="/join" class="primary">Join the Club</a>
        <a href="/schedule" class="secondary">View Schedule</a>
        <SocialMediaStrip />
      </div>
    </div>
  </div>
  
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Image layout */
  .images {
    display: grid;
    grid-template-columns: 1fr 1.3fr 1fr;
    height: 100%;
  }

  .images-mobile {
    display: none;
  }

  .side-image,
  .center-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mobile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .side-image {
    filter: brightness(0.85) saturate(0.9);
  }

  .center-image {
    filter: brightness(1);
  }

  /* Text overlay */
  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.35));
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    pointer-events: none;
  }

  .content {
    padding: 2rem;
    text-align: center;
    color: #ffffff;
    pointer-events: auto;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  p {
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    color: #f0f0f0;
  }

  .cta {
    display: flex;
    gap: 1rem;
    justify-content: space-around;
    flex-wrap: wrap;
  }

  .cta a {
    display:flex;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    align-items:center;
    justify-content:center;
  }

  .SocialMediaStrip {
    height: 25x;
    justify-content: center;
    align-items: center; /* Centers vertically */
  }

  .primary {
    background: #f5c400;
    color: #111;
  }

  .primary:hover {
    background: #ddb000;
  }

  .secondary {
    border: 2px solid #ffffff;
    color: #ffffff;
  }

  .secondary:hover {
    background: #ffffff;
    color: #111;
  }

  /* Mobile */
  @media (max-width: 900px) {
    .images-desktop {
      display: none;
    }

    .images-mobile {
      display: block;
      height: 100%;
    }

    .side-image {
      display: none;
    }
  }
</style>
