---
// Base layout for an Astro site
// Usage:
// ---
// import BaseLayout from "../layouts/BaseLayout.astro";
// ---
// <BaseLayout title="My Site">...</BaseLayout>
import harry_icon from "../assets/harry.svg";
import SponsorStrip from "../components/SponsorStrip.astro";
import SocialMediaStrip from "../components/SocialMediaStrip.astro";
const { title = "My Website" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav class="top-nav">
        <div class="nav-left">
          <a href="/" class="harry_header_icon">
            <img src={harry_icon.src} alt="Harry Icon" />
          </a>
        </div>
        <div class="nav-center">
          <div class="nav-links">
            <a href="/about-us/">About Us</a>
            <a href="/join/">Becoming a Hooligan</a>
            <a href="/schedule/">Schedule</a>
            <a href="/sponsors/">Sponsors</a>
            <a href="/culture/">Culture</a>
            <a href="/contact-us/">Contact Us</a>
          </div>
        </div>

      

        <button class="mobile-menu-toggle" > ☰ </button>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div id = "footer-section-1"><SponsorStrip/></div>
      <div id = "footer-section-2"><SocialMediaStrip/> </div>
    </footer>

    <script>
      const toggle = document.querySelector(".mobile-menu-toggle");
      const navLinks = document.querySelector(".nav-links");

      toggle?.addEventListener("click", () => {
        const isOpen = navLinks?.classList.toggle("active");
        toggle.classList.toggle("active");
        toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
        document.body.style.overflow = isOpen ? "hidden" : "";
      });

      // Close menu when clicking a link
      navLinks?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          navLinks.classList.remove("active");
          toggle?.classList.remove("active");
          toggle?.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
        });
      });

      // Close menu on escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && navLinks?.classList.contains("active")) {
          navLinks.classList.remove("active");
          toggle?.classList.remove("active");
          toggle?.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    --primary: #1f3c88;
    --accent: #d4af37;
    --bg: #ffffff;
    --text: #1a1a1a;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    color: var(--text);
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Top navigation */
  header {
    background: linear-gradient(90deg, var(--primary), var(--accent));
    color: white;
    padding: 1rem 1.5rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .top-nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    width: 100%;
  }

  .nav-left {
    display: flex;
    align-items: center;
    padding-left: 1.5rem;
  }

  .nav-center {
    display: flex;
    justify-content: center;
  }

  .nav-links {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }

  .harry_header_icon {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .harry_header_icon img {
    height: 48px;
  }

  .harry_header_icon {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    z-index: 102;
  }

  .harry_header_icon img {
    height: 40px;
    width: auto;
    display: block;
  }

  /* Mobile menu toggle */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 102;
  }

  .mobile-menu-toggle span {
    display: block;
    width: 25px;
    height: 3px;
    background: white;
    border-radius: 3px;
    transition: all 0.3s ease;
  }

  .mobile-menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(7px, 7px);
  }

  .mobile-menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  /* Navigation links */
  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .nav-links a:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Main content */
  main {
    flex: 1;
    margin: 2rem auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  /* Footer */
  footer {
    background: #3f3f44;
    color: #eee;
    padding: 1.5rem 1rem;
    height: 10vh;
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: space-between;
    width: 100%;
  }

  .bottom-nav {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #222;
    color: #eee;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .social-link:hover {
    background: var(--accent);
    color: #111;
  }

  .social-link svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  /* Tablet breakpoint */
  @media (max-width: 900px) {
    .nav-links {
      gap: 1rem;
    }

    .nav-links a {
      font-size: 0.9rem;
    }
  }

  /* Mobile breakpoint */
  @media (max-width: 768px) {
    header {
      padding: 1rem;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: -100%;
      width: 280px;
      max-width: 80vw;
      height: 100vh;
      background: var(--primary);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 2rem;
      transition: right 0.3s ease;
      box-shadow: -2px 0 10px rgba(0, 0, 0, 0.2);
    }

    .nav-links.active {
      right: 0;
    }

    .nav-links a {
      font-size: 1.1rem;
      padding: 0.5rem 1rem;
    }

    main {
      margin: 1.5rem auto;
      padding: 0 1rem;
    }

    .harry_header_icon img {
      height: 35px;
    }
  }

  /* Small mobile breakpoint */
  @media (max-width: 480px) {
    .harry_header_icon img {
      height: 30px;
    }

    .social-link {
      width: 40px;
      height: 40px;
    }

    .social-link svg {
      width: 20px;
      height: 20px;
    }

    .bottom-nav {
      gap: 1rem;
    }


    .nav-right {
  display: flex;
  gap: 0.75rem;
  padding-right: 1.5rem;
}

header .social-link {
  background: rgba(255,255,255,0.15);
}

header .social-link:hover {
  background: var(--accent);
}

.footer-section-1{
  max-height:100%;
  max-width: 100%;
  display: flex;
  gap: 1rem;
}
  }
</style>
