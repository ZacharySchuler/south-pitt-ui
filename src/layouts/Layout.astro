---
// Base layout for an Astro site
import harry_icon from "../assets/harry.svg";
import SponsorStrip from "../components/SponsorStrip.astro";

const {
  title = "South Pitt Rugby",
  description = "South Pittsburgh Rugby Football Club builds community and competition for players of every skill level in Southwestern Pennsylvania.",
} = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL(harry_icon.src, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="South Pittsburgh Rugby" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="South Pitt Rugby crest" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
  </head>

  <body>
    <header>
      <nav class="top-nav">
        <div class="nav-left">
          <a href="/" class="harry_header_icon">
            <img src={harry_icon.src} alt="Harry Icon" />
          </a>
        </div>

        <div class="nav-center">
          <div class="nav-links" aria-hidden="true">
            <button class="mobile-menu-close" type="button" aria-label="Close menu">
              ✕
            </button>
            <a href="/about-us/">About Us</a>
            <a href="/join/">Becoming a Hooligan</a>
            <a href="/schedule/">Schedule</a>
            <a href="/culture/">Culture</a>
            <a href = "sponsors/">Sponsors</a>
            <a href="/contact-us/">Contact Us</a>
          </div>
        </div>

        <button class="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false">
          ☰
        </button>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <SponsorStrip />
    </footer>

    <script>
      const toggle = document.querySelector(".mobile-menu-toggle");
      const navLinks = document.querySelector(".nav-links");
      const closeButton = document.querySelector(".mobile-menu-close");

      const setMenuState = (isOpen) => {
        navLinks?.classList.toggle("active", isOpen);
        navLinks?.setAttribute("aria-hidden", String(!isOpen));
        toggle?.setAttribute("aria-expanded", String(isOpen));
        document.body.style.overflow = isOpen ? "hidden" : "";
      };

      toggle?.addEventListener("click", () => {
        const isOpen = !navLinks?.classList.contains("active");
        setMenuState(isOpen);
      });

      closeButton?.addEventListener("click", () => {
        setMenuState(false);
      });

      navLinks?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          setMenuState(false);
        });
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          setMenuState(false);
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    --primary: #1f3c88;
    --accent: #d4af37;
    --bg: #ffffff;
    --text: #1a1a1a;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    height: 100%;
  }

  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: var(--bg);
    color: var(--text);

    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  /* ================= HEADER ================= */

  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-bottom: 1px solid #ffffff;
  }

  .top-nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    padding: 1rem 1.5rem;
  }

  .nav-left {
    display: flex;
    align-items: center;
  }

  .harry_header_icon img {
    height: 40px;
    display: block;
  }

  .nav-center {
    display: flex;
    justify-content: center;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }

  .nav-links a:hover {
    text-decoration: underline;
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 1.5rem;
    color: white;
    cursor: pointer;
  }

  .mobile-menu-close {
    display: none;
    background: none;
    border: none;
    font-size: 1.75rem;
    color: white;
    cursor: pointer;
  }

  /* ================= MAIN ================= */

  main {
    flex: 1;
    width: 100%;
  }

  /* ================= FOOTER ================= */

  footer {
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-top: 1px solid #ffffff;
    color: white;

    display: flex;
    justify-content: center;
    flex-shrink: 0;
    width: 100%;
    min-height: 10vh;
  }

  .sponsor-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;

    width: 100%;
    max-width: 1200px;
    gap: 1rem;
    padding: 1rem 2rem;
  }

  .sponsor-strip img {
    width: 50px;
    height: 50px;
    object-fit: contain;
  }

  /* ================= MOBILE ================= */

  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: block;
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: -100%;
      height: 100vh;
      width: 280px;
      background: var(--primary);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 2rem;
      transition: right 0.3s ease;
    }

    .nav-links.active {
      right: 0;
    }

    .mobile-menu-close {
      display: block;
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .sponsor-strip img {
      width: 40px;
      height: 40px;
    }
  }
</style>
